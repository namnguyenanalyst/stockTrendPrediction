# ==============================================================================
# Monorepo .gitignore (ML, API, Frontend, Infra)
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Variables & Secrets (Bảo mật & Chứng thư số)
.env
.env.*
!.env.example
secrets.toml
*/secrets.toml
.streamlit/
credentials.json
token.json
jwt.json
*.pem
*.key
*.p12
*.crt

# Log Files
*.log
*.log.*
logs/

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
*.venv
pyvenv.cfg
pip-selfcheck.json

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Tools & Caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter Notebooks Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Machine Learning (CCDS v2 Data & Model checkpoints)
# Ngăn chặn commit toàn bộ dữ liệu thô và mô hình nặng vào Git
apps/ml/data/raw/*
!apps/ml/data/raw/.gitkeep
apps/ml/data/interim/*
!apps/ml/data/interim/.gitkeep
apps/ml/data/processed/*
!apps/ml/data/processed/.gitkeep
apps/ml/data/external/*
!apps/ml/data/external/.gitkeep
apps/ml/models/*
!apps/ml/models/.gitkeep
*.pth
*.pt
*.pkl
*.joblib
*.h5

# Frontend (Next.js / Node)
node_modules/
apps/web/node_modules/
.next/
apps/web/.next/
out/
apps/web/out/
build/
dist/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Database & Docker Volumes / Local Override
postgres_data/
*.sqlite3
*.sqlite
*.db
*.dump
docker-compose.override.yml
docker-compose.override.yaml

# References, Scratch & Private Documentation
references/
scratch/
fc-data/
docs/

# IDE Configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/