    "# ==============================================================================\n",
    "# CẤU HÌNH HỆ THỐNG & IMPORT THƯ VIỆN\n",
    "# ==============================================================================\n",
    "# Bước này thiết lập môi trường tính toán, cấu hình chống xung đột luồng trên macOS\n",
