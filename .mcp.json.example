{
  "mcpServers": {
    "postgresql": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "env": {
        "POSTGRES_CONNECTION_STRING": "postgresql://your_user:your_password@localhost:5432/vn_stock"
      }
    },
    "arxiv-mcp-server": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--python",
        "3.12",
        "--with",
        "arxiv-mcp-server",
        "infra/mcp/arxiv_mcp_wrapper.py"
      ]
    }
  }
}
