# ==============================================================================
# VN STOCK PREDICTION & QUANTITATIVE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Sao chép file này thành '.env' và điều chỉnh các giá trị phù hợp với môi trường.
# LƯU Ý: Không bao giờ commit file '.env' thực tế chứa secrets/passwords vào Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL 16 (PostgreSQL Database Settings)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vn_stock
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL kết nối cơ sở dữ liệu SQLAlchemy 2.0:
# - Chế độ phát triển cục bộ (Local Development):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vn_stock
# - Chế độ Docker Compose (Container Networking):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@vn_stock_db:5432/vn_stock

# Database Connection Pool Tuning:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# 2. XÁC THỰC & BẢO MẬT JWT (Authentication, Bcrypt & JWT Security)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT - BẮT BUỘC thay đổi chuỗi ngẫu nhiên tối thiểu 32 ký tự trên Production!
SECRET_KEY=super_secret_jwt_key_must_be_changed_in_prod_32chars
JWT_SECRET_KEY=super_secret_jwt_key_must_be_changed_in_prod_32chars

# Thuật toán mã hóa JWT (mặc định: HS256)
ALGORITHM=HS256
JWT_ALGORITHM=HS256

# Thời hạn Access Token ngắn hạn (phút) và Refresh Token dài hạn (ngày)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MẠNG & CORS WHITELIST (Networking & CORS Allowed Origins)
# ------------------------------------------------------------------------------
# Danh sách origins được phép kết nối API từ browser (JSON format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Cổng dịch vụ Docker Compose ánh xạ ra máy chủ (Host Port Mapping)
API_PORT=8000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 4. GIAO DIỆN FRONTEND NEXT.JS (Web Dashboard Settings)
# ------------------------------------------------------------------------------
# URL API Backend cho browser client gọi trực tiếp
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL API nội bộ cho Next.js Server Components / SSR kết nối trong mạng Docker
API_INTERNAL_URL=http://vn_stock_api:8000

# Cấu hình máy chủ web Next.js
PORT=3000
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 5. MÔI TRƯỜNG & HỆ THỐNG ML (System & ML Pipeline Configuration)
# ------------------------------------------------------------------------------
# Môi trường chạy: development | production | test
ENVIRONMENT=production

# Tự động đồng bộ nến thị trường mới nhất khi khởi động API
AUTO_SYNC_ON_STARTUP=true

# ------------------------------------------------------------------------------
# 6. THAM SỐ ĐỊNH LƯỢNG VI CẤU TRÚC THỊ TRƯỜNG VIỆT NAM (Vietnam Microstructure)
# ------------------------------------------------------------------------------
# Tài liệu tham chiếu chuẩn cho Engine Backtesting:
# - Phí giao dịch chứng khoán cơ sở: 0.15% giá trị lệnh (mỗi chiều Mua và Bán)
# - Thuế thu nhập cá nhân chuyển nhượng cổ phiếu: 0.10% giá trị bán
# - Chu kỳ thanh toán theo quy định UBCKNN: T+2.5 (cổ phiếu về tài khoản chiều T+2, khả dụng giao dịch T+3)
# - Quy cách bước khối lượng lệnh: Lô chẵn 100 cổ phiếu (HSX/HNX)
# - Quản trị rủi ro mặc định: Cắt lỗ (Stop Loss) -7.0%, Chốt lời (Take Profit) +15.0%, Trailing Stop 5.0%
DEFAULT_TRANSACTION_FEE_RATE=0.0015
DEFAULT_TAX_RATE=0.0010
DEFAULT_SETTLEMENT_DAYS=3
DEFAULT_LOT_SIZE=100
DEFAULT_STOP_LOSS=0.07
DEFAULT_TAKE_PROFIT=0.15
DEFAULT_TRAILING_STOP=0.05
